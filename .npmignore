# Maintainer acceptance tooling that writes to a real device, and the script that drives it. Every other
# script here is observation-only; these two turn a camera off and on, so they stay out of the package a
# user installs.
scripts/eufy-camera-power.mjs
scripts/live-hap-disabled-camera-check.mjs

